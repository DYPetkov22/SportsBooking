# Build output / IDE files
**/bin/
**/obj/
.idea/
.vs/
*.user
*.suo
# User data and locally uploaded files must never be committed
**/App_Data/
**/*.db
**/*.db-shm
**/*.db-wal
# SQL Server runtime files and backups (commit the SQL projects instead)
*.mdf
*.ndf
*.ldf
*.bak
*.trn
*.dacpac
*.bacpac
*.dbmdl
*.jfm
# Secret overrides (environment variables recommended)
**/appsettings.Local.json
**/secrets.json
*.pfx
*.p12
# Temp files
*.tmp
.DS_Store

# Runtime error logs
**/App_Data/Logs/
**/TestResults/
