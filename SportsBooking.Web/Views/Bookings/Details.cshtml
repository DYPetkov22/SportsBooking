@model Booking
@{ ViewData["Title"] = "Преглед на запис"; }
<div class="page-heading"><h1>Преглед на запис №@Model.BookingID</h1><a asp-action="Index">← Назад</a></div>
<section class="panel narrow"><dl class="details"><dt>Потребител</dt><dd>@(Model.User?.FullName)</dd>
<dt>Игрище</dt><dd>@(Model.Field?.FieldName)</dd>
<dt>Дата</dt><dd>@Model.BookingDate.ToString("dd.MM.yyyy")</dd>
<dt>От</dt><dd>@Model.StartTime.ToString("HH:mm")</dd>
<dt>До</dt><dd>@Model.EndTime.ToString("HH:mm")</dd>
<dt>Статус</dt><dd>@Model.Status</dd></dl>
<div class="buttons">@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="btn primary" asp-action="Edit" asp-route-id="@Model.BookingID">Редактирай</a> }<a class="btn" asp-action="Index">Назад</a></div></section>
