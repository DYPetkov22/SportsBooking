@model Field
@{ ViewData["Title"] = "Преглед на запис"; }
<div class="page-heading"><h1>Преглед на запис №@Model.FieldID</h1><a asp-action="Index">← Назад</a></div>
<section class="panel narrow"><dl class="details"><dt>Игрище</dt><dd>@Model.FieldName</dd>
<dt>Център</dt><dd>@(Model.Center?.CenterName)</dd>
<dt>Спорт</dt><dd>@(Model.Sport?.SportName)</dd>
<dt>Цена/час (EUR)</dt><dd>@Model.PricePerHour.ToString("F2")</dd></dl>
<div class="buttons">@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="btn primary" asp-action="Edit" asp-route-id="@Model.FieldID">Редактирай</a> }<a class="btn" asp-action="Index">Назад</a></div></section>
