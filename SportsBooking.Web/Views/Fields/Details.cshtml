@model Field
@{ ViewData["Title"] = "Преглед на запис"; }
<div class="page-heading"><h1>Преглед на запис №@Model.FieldID</h1><a asp-action="Index">← Назад</a></div>
<section class="panel narrow"><dl class="details"><dt>Игрище</dt><dd>@Model.FieldName</dd>
<dt>Център</dt><dd>@(Model.Center?.CenterName)</dd>
<dt>Спорт</dt><dd>@(Model.Sport?.SportName)</dd>
<dt>Цена/час (EUR)</dt><dd>@Model.PricePerHour.ToString("F2")</dd></dl>
<div class="buttons">@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="btn primary" asp-action="Edit" asp-route-id="@Model.FieldID">Редактирай</a> }<a class="btn" asp-action="Index">Назад</a></div></section>

@{
    var photos = ViewBag.Images as IReadOnlyList<SportsBooking.Web.Services.StoredUpload>
        ?? Array.Empty<SportsBooking.Web.Services.StoredUpload>();
    var canManageGallery = User.IsInRole("Admin") || User.IsInRole("Manager");
}
<section class="panel media-panel">
    <h2>Галерия на игрището</h2>
    @if (TempData["FileError"] is string error)
    {
        <div class="alert error" role="alert">@error</div>
    }
    @if (photos.Count > 0)
    {
        <div class="gallery-grid">
        @foreach (var photo in photos)
        {
            <div class="gallery-tile">
                <img src="@Url.Action("FieldImage", "Files", new { fieldId = Model.FieldID, uploadId = photo.Id })" alt="@photo.OriginalFileName" loading="lazy" />
                @if (canManageGallery)
                {
                    <form asp-controller="Files" asp-action="DeleteFieldImage" asp-route-fieldId="@Model.FieldID" asp-route-uploadId="@photo.Id" method="post">
                        <button class="btn small" type="submit" onclick="return confirm('Да изтрия ли снимката?')">Премахни</button>
                    </form>
                }
            </div>
        }
        </div>
    }
    else
    {
        <p class="empty">Няма добавени снимки.</p>
    }
    @if (canManageGallery)
    {
        <p class="muted">До 12 снимки JPEG/PNG, максимум 5 MB всяка, автоматично оптимизирани до 1280 px.</p>
        @if (photos.Count < SportsBooking.Web.Services.LocalFileStorage.MaxImagesPerField)
        {
            <form asp-controller="Files" asp-action="UploadFieldImage" asp-route-fieldId="@Model.FieldID" method="post" enctype="multipart/form-data" class="upload-form">
                <div class="field"><label for="field-photo">Добави снимка в галерията</label>
                    <input id="field-photo" type="file" name="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
                </div>
                <button class="btn primary" type="submit">Добави снимка</button>
            </form>
        }
    }
</section>
