@model IEnumerable<Sport>
@{ ViewData["Title"] = "Спортове"; }
<div class="page-heading"><h1>Спортове</h1>@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-action="Create" class="btn primary">+ Добави</a> }</div>
<div class="table-scroll">
    <table>
        <thead><tr><th>Вид спорт</th><th>Действия</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SportName</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@item.SportID">Преглед</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-action="Edit" asp-route-id="@item.SportID">Редакция</a> }
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="danger-text" asp-action="Delete" asp-route-id="@item.SportID">Изтриване</a> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (!Model.Any()) { <p class="empty">Все още няма записи.</p> }
