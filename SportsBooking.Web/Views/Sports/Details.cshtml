@model Sport
@{ ViewData["Title"] = "Преглед на запис"; }
<div class="page-heading"><h1>Преглед на запис №@Model.SportID</h1><a asp-action="Index">← Назад</a></div>
<section class="panel narrow"><dl class="details"><dt>Вид спорт</dt><dd>@Model.SportName</dd></dl>
<div class="buttons">@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="btn primary" asp-action="Edit" asp-route-id="@Model.SportID">Редактирай</a> }<a class="btn" asp-action="Index">Назад</a></div></section>
