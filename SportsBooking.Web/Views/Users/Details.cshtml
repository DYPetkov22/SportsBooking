@model User
@{ ViewData["Title"] = "Преглед на запис"; }
<div class="page-heading"><h1>Преглед на запис №@Model.UserID</h1><a asp-action="Index">← Назад</a></div>
<section class="panel narrow"><dl class="details"><dt>Име</dt><dd>@Model.FullName</dd>
<dt>Имейл</dt><dd>@Model.Email</dd>
<dt>Телефон</dt><dd>@Model.Phone</dd></dl>
<div class="buttons"><a class="btn primary" asp-action="Edit" asp-route-id="@Model.UserID">Редактирай</a><a class="btn" asp-action="Index">Назад</a></div></section>
