@model User
<div class="field">
    <label asp-for="FullName"></label>
    <input asp-for="FullName" type="text" class="input" />
    <span asp-validation-for="FullName" class="validation"></span>
</div>
<div class="field">
    <label asp-for="Email"></label>
    <input asp-for="Email" type="email" class="input" />
    <span asp-validation-for="Email" class="validation"></span>
</div>
<div class="field">
    <label asp-for="Phone"></label>
    <input asp-for="Phone" type="tel" class="input" />
    <span asp-validation-for="Phone" class="validation"></span>
</div>
