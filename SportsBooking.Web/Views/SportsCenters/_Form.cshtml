@model SportsCenter
<div class="field">
    <label asp-for="CenterName"></label>
    <input asp-for="CenterName" type="text" class="input" />
    <span asp-validation-for="CenterName" class="validation"></span>
</div>
<div class="field">
    <label asp-for="City"></label>
    <input asp-for="City" type="text" class="input" />
    <span asp-validation-for="City" class="validation"></span>
</div>
