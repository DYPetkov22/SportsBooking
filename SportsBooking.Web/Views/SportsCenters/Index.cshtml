@model IEnumerable<SportsCenter>
@{ ViewData["Title"] = "Спортни центрове"; }
<div class="page-heading"><h1>Спортни центрове</h1>@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-action="Create" class="btn primary">+ Добави</a> }</div>
<div class="table-scroll">
    <table>
        <thead><tr><th>Център</th>
<th>Град</th><th>Действия</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CenterName</td>
<td>@item.City</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@item.CenterID">Преглед</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-action="Edit" asp-route-id="@item.CenterID">Редакция</a> }
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="danger-text" asp-action="Delete" asp-route-id="@item.CenterID">Изтриване</a> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (!Model.Any()) { <p class="empty">Все още няма записи.</p> }
