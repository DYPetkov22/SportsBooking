@model SportsCenter
@{
    ViewData["Title"] = "Редактиране — Спортни центрове";
}
<div class="page-heading"><h1>@ViewData["Title"]</h1><a asp-action="Index">← Назад към списъка</a></div>
<section class="panel narrow">
    <form asp-action="Edit" asp-route-id="@(Model.CenterID)" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        @await Html.PartialAsync("_Form", Model)
        <div class="buttons"><button class="btn primary" type="submit">Запази</button><a class="btn" asp-action="Index">Отказ</a></div>
    </form>
</section>
