@model User
@{
    ViewData["Title"] = "Моят профил";
}
<div class="page-heading"><h1>Моят профил</h1><a asp-controller="Bookings" asp-action="Index">Моите резервации</a></div>
<section class="panel narrow">
    <dl class="details">
        <dt>Име</dt><dd>@Model.FullName</dd>
        <dt>Имейл</dt><dd>@Model.Email</dd>
        <dt>Телефон</dt><dd>@(Model.Phone ?? "—")</dd>
    </dl>
    @await Html.PartialAsync("_ProfileImageEditor", Model)
</section>
