@model SportsBooking.Web.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }
<div class="page-heading"><h1>Регистрация</h1></div>
<section class="panel narrow auth-panel">
    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="All" class="validation"></div>
        <div class="field"><label asp-for="FullName">Име и фамилия</label><input asp-for="FullName" class="input" autocomplete="name"/><span asp-validation-for="FullName" class="validation"></span></div>
        <div class="field"><label asp-for="Email">Имейл</label><input asp-for="Email" class="input" autocomplete="email"/><span asp-validation-for="Email" class="validation"></span></div>
        <div class="field"><label asp-for="Phone">Телефон</label><input asp-for="Phone" class="input" autocomplete="tel"/><span asp-validation-for="Phone" class="validation"></span></div>
        <div class="field"><label asp-for="Password">Парола</label><input asp-for="Password" autocomplete="new-password" class="input"/><span asp-validation-for="Password" class="validation"></span></div>
        <div class="field"><label asp-for="ConfirmPassword">Повторете паролата</label><input asp-for="ConfirmPassword" autocomplete="new-password" class="input"/><span asp-validation-for="ConfirmPassword" class="validation"></span></div>
        <p class="muted">Минимум 10 символа, главна и малка буква, цифра и специален знак.</p>
        <button class="btn primary" type="submit">Регистрация</button>
    </form>
</section>
